{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/*": [
        "../../plugins/sam-ui-kit/skills/ui-kit/assets/components/*"
      ],
      "@/lib/*": ["../../plugins/sam-ui-kit/skills/ui-kit/assets/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../plugins/sam-ui-kit/skills/ui-kit/assets/**/*.ts",
    "../../plugins/sam-ui-kit/skills/ui-kit/assets/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
